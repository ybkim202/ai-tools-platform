# backend 환경변수 템플릿
# 사용법: 값을 채워 셸에서 export 하거나, 이 파일을 backend/env 로 복사해 채운다.
#         (backend/env 와 .env* 는 gitignore — 실제 값은 절대 커밋하지 않는다. 헌법 G9)
# 로컬 실행 최소 요구: DATABASE_URL 하나면 된다. 나머지는 전부 선택.

# ── 필수 ──────────────────────────────────────────────
# PostgreSQL 접속 문자열. 로컬 DB 예시:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aitools

# ── 선택: API 서버 ─────────────────────────────────────
# CORS 허용 오리진(콤마 구분). 미설정 시 로컬 기본값(localhost:3000)이라 로컬 개발은 비워도 된다.
# 운영에서만 프론트 도메인으로 설정.
#ALLOWED_ORIGINS=https://your-frontend.vercel.app

# 보호 엔드포인트용 API 키(콤마 구분 복수는 API_KEYS). 미설정 시 유효 키 없음(폴백 없음).
#API_KEY=
#API_KEYS=

# 레이트리밋 X-Forwarded-For 신뢰 홉 수 (기본 1)
#RATE_LIMIT_TRUSTED_PROXIES=1

# 서버 포트 (기본 8000)
#PORT=8000

# ── 선택: 데이터 수집(collect.py / 스케줄러) ─────────────
# GitHub API 토큰 — 없어도 동작하나 레이트리밋이 낮아짐
#GITHUB_TOKEN=

# Product Hunt API 토큰 — 해당 수집기 사용 시에만
#PRODUCT_HUNT_TOKEN=

# MyMemory 번역 쿼터 확장용 이메일(선택)
#MYMEMORY_EMAIL=

# APScheduler 인프로세스 스케줄러 (기본 비활성 — GitHub Actions cron이 정본 경로)
#ENABLE_SCHEDULER=false
#SCHEDULER_WORKER=false
#COLLECT_INTERVAL_HOURS=

# 수집 임계값 튜닝(기본값 있음)
#GITHUB_TRENDING_MIN_STARS_WEEKLY=
#GITHUB_TRENDING_MIN_STARS_MONTHLY=
#HN_DISCOVER_MIN_POINTS=
