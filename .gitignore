
# Claude Code 개인 설정(알림 hook 등)
.claude/settings.local.json
# 개인 세션 로그(세션 기록 훅이 기록) — 팀원별 로컬 전용
.claude/local/

# UX 리뷰 등 세션 산출 보고서(로컬 부산물) — 결론은 docs/UX_REVIEW.md 정본에 반영
docs/reports/

# Python 컴파일 캐시 (히스토리에 키가 박혀 노출됐던 원인 — 절대 커밋 금지)
__pycache__/
*.pyc

# Python 가상환경 (로컬 전용 — collect.py 등 로컬 실행 시 생성)
.venv/
venv/

# OS / 에디터 부산물
.DS_Store

# 환경변수(시크릿)
.env
.env.*
!.env.example
# backend/env 는 비밀번호를 담을 수 있는 env 파일 — 추적 금지(템플릿도 커밋하지 않는다)
backend/env

# 로고 디자인 소스(대용량 바이너리) — 앱은 frontend/src/assets 사용
logo/*.ai

logo/**/*.ai
.DS_Store
